// Database schema — MongoDB (via Prisma). Both apps (web + admin) use the SAME
// MongoDB database (set DATABASE_URL to your MongoDB Atlas connection string).
// Keep this file identical to admin/prisma/schema.prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Post {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  slug       String   @unique
  excerpt    String   @default("")
  content    String   @default("")
  coverImage String   @default("")
  category   String   @default("General")
  author     String   @default("Admin")
  published  Boolean  @default(true)
  featured   Boolean  @default(false)
  views      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category])
  @@index([published])
}

model Visit {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  path      String
  session   String
  ref       String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([session])
}

model ShortLink {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  code      String   @unique
  url       String
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id @map("_id")
  value String @default("")
}

/// One generic record behind every "make it, then share a link" tool:
/// the Survey Builder, the Meeting Scheduler poll and the Link-in-Bio site
/// builder. `kind` says which tool made it and `data` holds that tool's own
/// JSON payload, so a new hosted tool needs no schema change.
///
/// `editToken` is the secret handed back to the creator once, at create time.
/// It is required to read a survey's responses or a poll's votes — the public
/// link only ever exposes the questions, never the answers.
model HostedItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  code      String   @unique
  kind      String
  title     String   @default("")
  data      String   @default("")
  editToken String   @default("")
  views     Int      @default(0)
  closed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
}

/// A single submission against a HostedItem — one survey response, or one
/// person's availability on a meeting poll. Linked by `code`, not by relation,
/// so a response never needs the parent loaded to be written.
model HostedResponse {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  code      String
  data      String   @default("")
  createdAt DateTime @default(now())

  @@index([code])
}

/// A keyword you have chosen to watch.
///
/// Ranking numbers themselves come from Google Search Console and are never
/// stored here — this is only the watchlist. Keeping it separate means a term
/// stays visible on the dashboard during weeks when it earns no impressions at
/// all, which is itself the useful signal: Search Console simply omits queries
/// that got no traffic, so without a watchlist those keywords silently vanish.
model Keyword {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  phrase    String   @unique
  note      String   @default("")
  createdAt DateTime @default(now())
}

/// A point-in-time capture of one query's Search Console metrics.
///
/// Search Console serves a rolling window and will tell you a query's average
/// position today, but not what it was a month ago. Movement is the thing you
/// actually want to see, so each refresh records a row here and the dashboard
/// diffs against the previous capture.
model KeywordSnapshot {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  phrase      String
  position    Float    @default(0)
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  rangeDays   Int      @default(28)
  capturedAt  DateTime @default(now())

  @@index([phrase])
  @@index([capturedAt])
}
