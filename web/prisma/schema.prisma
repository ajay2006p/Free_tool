// Database schema — MongoDB (via Prisma). Both apps (web + admin) use the SAME
// MongoDB database (set DATABASE_URL to your MongoDB Atlas connection string).
// Keep this file identical to admin/prisma/schema.prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Post {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  slug       String   @unique
  excerpt    String   @default("")
  content    String   @default("")
  coverImage String   @default("")
  category   String   @default("General")
  author     String   @default("Admin")
  published  Boolean  @default(true)
  featured   Boolean  @default(false)
  views      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category])
  @@index([published])
}

model Visit {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  path      String
  session   String
  ref       String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([session])
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  name         String   @default("")
  passwordHash String
  createdAt    DateTime @default(now())
}

model ShortLink {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  code      String   @unique
  url       String
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id @map("_id")
  value String @default("")
}

/// One generic record behind every "make it, then share a link" tool:
/// the Survey Builder, the Meeting Scheduler poll and the Link-in-Bio site
/// builder. `kind` says which tool made it and `data` holds that tool's own
/// JSON payload, so a new hosted tool needs no schema change.
///
/// `editToken` is the secret handed back to the creator once, at create time.
/// It is required to read a survey's responses or a poll's votes — the public
/// link only ever exposes the questions, never the answers.
model HostedItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  code      String   @unique
  kind      String
  title     String   @default("")
  data      String   @default("")
  editToken String   @default("")
  views     Int      @default(0)
  closed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
}

/// A single submission against a HostedItem — one survey response, or one
/// person's availability on a meeting poll. Linked by `code`, not by relation,
/// so a response never needs the parent loaded to be written.
model HostedResponse {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  code      String
  data      String   @default("")
  createdAt DateTime @default(now())

  @@index([code])
}
